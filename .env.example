# Server Configuration
PORT=4050
NODE_ENV=development

# Allowed Origins (comma-separated).
# Note: Chrome extensions (chrome-extension://*) and Figma plugin iframes (origin "null" or https://www.figma.com)
# are automatically supported when ALLOW_EXTENSION_AND_FIGMA_ORIGINS=true.
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://app.runvectorial.com,https://beta.runvectorial.com,https://www.figma.com
ALLOW_EXTENSION_AND_FIGMA_ORIGINS=true

# App Tenant Database URLs (same DB used by the 'app' tenant in vectorial-agent-frontend)
APP_PRISMA_DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=..."
APP_DIRECT_DATABASE_URL="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/app_db?sslmode=require"

# Optional Internal Service-to-Service API Key (via X-Invite-Internal-Key header)
INVITE_INTERNAL_API_KEY="replace-with-strong-32-byte-secret"

# Optional Dedicated Admin API Key (via X-Invite-Admin-Key header)
INVITE_ADMIN_API_KEY="replace-with-strong-admin-secret"

# Comma-separated list of Admin emails allowed via Vectorial Bearer Token Auth
INVITE_CODE_ADMIN_EMAILS="harvinder@runvectorial.com"

# Tenant gating: only require invite codes when tenant is 'app'
INVITE_CODE_TENANT="app"

# Vectorial Auth API Endpoints (for validating user Bearer tokens from web, Chrome extension, or Figma plugin)
VECTORIAL_AUTH_API_PROD="https://prod.us-west-2.auth-api.vectorialapi.com"
VECTORIAL_AUTH_API_BETA="https://auth-api.vectorialapi.com"
