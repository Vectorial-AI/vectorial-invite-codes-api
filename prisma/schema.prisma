generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("APP_PRISMA_DATABASE_URL")
  directUrl = env("APP_DIRECT_DATABASE_URL")
}

/// Invite codes for gating application access on the 'app' tenant.
/// Matches the exact InviteCode table in the app tenant database.
model InviteCode {
  id              String    @id @default(uuid())
  code            String    @unique
  note            String?
  /// Maximum number of accounts that may claim this code. NULL = unlimited.
  /// Defaults to 1 so pre-existing (single-use) codes keep their original behavior.
  maxClaims       Int?      @default(1)
  /// Legacy single-claim columns. No longer written; claims live in InviteCodeClaim.
  claimedByUserId String?   @unique
  claimedByEmail  String?
  claimedAt       DateTime?
  createdByEmail  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  claims InviteCodeClaim[]

  @@index([claimedByUserId])
}

/// One row per account that redeemed an invite code. Each account can claim at most one code.
model InviteCodeClaim {
  id           String     @id @default(uuid())
  inviteCodeId String
  userId       String     @unique
  email        String?
  claimedAt    DateTime   @default(now())
  inviteCode   InviteCode @relation(fields: [inviteCodeId], references: [id], onDelete: Cascade)

  @@index([inviteCodeId])
  @@index([email])
}
